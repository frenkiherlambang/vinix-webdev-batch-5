# Supabase project settings: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Older Supabase projects expose an anon key instead of a publishable key.
# The app falls back to it when the publishable key is not set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin used in Google and email sign-in redirects (no trailing slash).
# Leave it unset on localhost: the request origin is used instead.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain

# Add the callback URL to Supabase -> Authentication -> URL Configuration
# for every origin the app runs on:
#   http://localhost:3000/auth/callback
#   https://your-production-domain/auth/callback
